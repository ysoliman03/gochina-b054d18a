# Copy this file to .env and fill in your key.
# The agent currently uses Anthropic Claude Haiku 4.5 — see the active
# model line in agent.py.
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional: Langfuse tracing (see server.py's _setup_langfuse) ──────────
# If unset, tracing is silently disabled — no other code changes needed.
# LANGFUSE_PUBLIC_KEY=...
# LANGFUSE_SECRET_KEY=...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Want to switch LLM providers? ─────────────────────────────────────────
# Groq (free tier, llama-3.3-70b) — https://console.groq.com
# GROQ_API_KEY=...
#
# Google Gemini (free tier) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
#
# OpenAI (gpt-4o-mini, ~$0.001/plan) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
#
# Then change the model in agent.py (see the comment at the top of that file).
