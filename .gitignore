# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local
# NOTE: root .env is intentionally tracked, not ignored — Lovable's build
# (vite-tanstack-config's envDefine) reads VITE_* values straight out of the
# checked-out .env file via Vite's loadEnv(). Untracking it breaks the live
# Lovable build (confirmed 2026-07). If you need a local-only override, use
# .env.local instead (already covered by *.local above).
nohup.out

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Kubernetes secrets
k8s/secret.yaml

# Python agent
agent/.venv/
agent/data/            # auto-generated by `bun run export:data`
agent/.env
__pycache__/
*.pyc

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
