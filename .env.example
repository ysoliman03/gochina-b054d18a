# Copy this file to .env and fill in your own values. Never commit the real .env.
#
# Supabase project (auth + itinerary sync) — https://supabase.com/dashboard
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project-id.supabase.co

# Same Supabase values, prefixed for Vite so they're available client-side
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Gaode (Amap) — used for the itinerary map and transit/directions links
# https://lbs.amap.com
VITE_GAODE_API_KEY=your-gaode-api-key
VITE_GAODE_SECURITY_KEY=your-gaode-security-key
